# Copy to .env.local (never commit real values).
# Everything prefixed VITE_ is bundled into the public JS. Put NO secrets here.
# The Paystack SECRET key must live only on the backend.

# Base URL of your .NET API
VITE_API_BASE_URL=https://localhost:7060

# Set to true only if the backend keeps the login session in an httpOnly refresh
# cookie (recommended). Needs CORS with AllowCredentials and an explicit origin.
VITE_API_WITH_CREDENTIALS=false
